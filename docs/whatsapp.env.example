# WhatsApp Cloud API (Meta)
# Mantenha false até executar a migration 021 e aprovar os cinco templates.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Use somente no ambiente de teste da Meta.
# Quando preenchido, toda mensagem vai para este número.
WHATSAPP_TEST_RECIPIENT=

# Templates aprovados
WHATSAPP_TEMPLATE_NOVO_AGENDAMENTO=novo_agendamento
WHATSAPP_TEMPLATE_CONFIRMACAO_CLIENTE=confirmacao_agendamento_cliente
WHATSAPP_TEMPLATE_LEMBRETE_CLIENTE=lembrete_agendamento_cliente
WHATSAPP_TEMPLATE_CANCELAMENTO_PROFISSIONAL=cancelamento_agendamento_profissional
WHATSAPP_TEMPLATE_CANCELAMENTO_CLIENTE=cancelamento_agendamento_cliente

# Worker
WHATSAPP_REMINDER_HOURS=24
WHATSAPP_WORKER_INTERVAL_MS=30000
WHATSAPP_WORKER_BATCH_SIZE=20
