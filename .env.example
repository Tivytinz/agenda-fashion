# Origens separadas por vírgula.
# Em branco, o backend usa os domínios padrão do Agenda Fashion.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://app.agendafashion.com.br

# Banco e autenticação. Nunca exponha estes valores em VITE_*.
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Limites do PostgreSQL em milissegundos.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=15000
DB_QUERY_TIMEOUT=20000
DB_LOCK_TIMEOUT=5000
DB_IDLE_TRANSACTION_TIMEOUT=15000

# Pagamentos Asaas.
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Imagens públicas.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origem pública canônica. Backend e frontend devem apontar para o mesmo domínio.
PUBLIC_APP_URL=https://app.agendafashion.com.br
VITE_PUBLIC_APP_URL=https://app.agendafashion.com.br
PASSWORD_RESET_EMAIL_ENABLED=false
RESEND_API_KEY=
PASSWORD_RESET_EMAIL_FROM=Agenda Fashion <contato@agendafashion.com.br>

# Níveis aceitos: informacao, aviso, erro ou silencioso.
LOG_LEVEL=aviso

# Os testes ficam silenciosos por padrão. Ative apenas para investigar uma falha.
DEBUG_TEST_LOGS=false

# Ative somente depois de aprovar os modelos usados e aplicar as migrations.
WHATSAPP_NOTIFICATIONS_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_NOVO_AGENDAMENTO=novo_agendamento
WHATSAPP_TEMPLATE_CONFIRMACAO_CLIENTE=confirmacao_agendamento_cliente
WHATSAPP_TEMPLATE_LEMBRETE_CLIENTE=lembrete_agendamento
WHATSAPP_TEMPLATE_LEMBRETE_PROFISSIONAL=lembrete_agendamento_profissional
WHATSAPP_TEMPLATE_CANCELAMENTO_PROFISSIONAL=cancelamento_agendamento_profissional
WHATSAPP_TEMPLATE_CANCELAMENTO_CLIENTE=cancelamento_agendamento
WHATSAPP_PROFESSIONAL_REMINDER_ENABLED=false
WHATSAPP_TEMPLATE_PRIMEIRO_SERVICO=lembrete_primeiro_servico
WHATSAPP_TEMPLATE_DIVULGAR_NEGOCIO=lembrete_divulgar_negocio
WHATSAPP_FIRST_SERVICE_REMINDER_ENABLED=false
WHATSAPP_SHARE_REMINDER_ENABLED=false
WHATSAPP_BUSINESS_REMINDER_HOUR=10
WHATSAPP_BUSINESS_REMINDER_MAX_SENDS=3
WHATSAPP_BUSINESS_REMINDER_INTERVAL_DAYS=3
WHATSAPP_BUSINESS_REMINDER_SCAN_INTERVAL_MS=300000
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_CONVERSATION_AUTOREPLIES_ENABLED=false
WHATSAPP_WORKER_INTERVAL_MS=30000
WHATSAPP_WORKER_BATCH_SIZE=20

# Meta Ads fica desligado até Pixel, token e consentimento estarem prontos.
# META_CAPI_ACCESS_TOKEN é segredo de backend e nunca deve ir para VITE_* ou para o navegador.
META_ADS_ENABLED=false
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_CAPI_TEST_EVENT_CODE=
META_CAPI_TIMEOUT_MS=1800

# Google Analytics e Google Ads ficam desligados até a propriedade e as conversões serem configuradas.
# GA4_API_SECRET é segredo de backend e nunca deve ser exposto ao navegador.
GOOGLE_MEASUREMENT_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GOOGLE_ADS_ID=
GOOGLE_ADS_SIGNUP_LABEL=
GOOGLE_ADS_CHECKOUT_LABEL=
GOOGLE_MEASUREMENT_TIMEOUT_MS=1800

# Fase 11: leitura de custos de mídia.
# Essas credenciais são exclusivamente de backend. Não reutilize o token CAPI da Meta
# como token de Marketing API e nunca exponha nenhum destes valores via VITE_*.
MARKETING_COST_SYNC_TIMEOUT_MS=10000
# A Fase 13.2 exibe este estado no admin. Quando ativo, o painel também mostra
# o intervalo e considera a integração desatualizada após duas janelas sem sucesso.
# Quando desligado, a sincronização manual continua disponível e a janela é de 24h.
MARKETING_COST_SYNC_SCHEDULE_ENABLED=false
MARKETING_COST_SYNC_INTERVAL_HOURS=6

GOOGLE_ADS_COSTS_ENABLED=false
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

META_ADS_COSTS_ENABLED=false
META_AD_ACCOUNT_ID=
META_MARKETING_ACCESS_TOKEN=

# TikTok Ads: OAuth é iniciado pelo admin e os tokens são persistidos criptografados.
# App Secret, chave de criptografia e tokens são exclusivamente de backend.
TIKTOK_ADS_COSTS_ENABLED=false
TIKTOK_ADVERTISER_ID=
TIKTOK_API_VERSION=v1.3
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Use uma chave aleatória forte com pelo menos 32 caracteres e não a reutilize como JWT_SECRET.
TIKTOK_OAUTH_ENCRYPTION_KEY=
TIKTOK_OAUTH_REDIRECT_URI=https://app.agendafashion.com.br/admin/trafego-pago/custos
# Compatibilidade temporária: um token manual pode ser usado quando não houver OAuth salvo.
TIKTOK_ADS_ACCESS_TOKEN=

# Fase 13: régua conservadora de decisão por campanha.
# A recomendação é apenas informativa: o AF não pausa nem escala campanhas automaticamente.
# 1.00 significa equilíbrio entre receita atribuída do primeiro pagamento e investimento.
MARKETING_DECISION_ROAS_TARGET=1.00
MARKETING_DECISION_SCALE_MULTIPLIER=1.20
MARKETING_DECISION_MIN_SIGNUPS=10
MARKETING_DECISION_MIN_SUBSCRIPTIONS=2
