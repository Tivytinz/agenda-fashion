# Origens separadas por vírgula.
# Em branco, o backend usa os domínios padrão do Agenda Fashion.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://app.agendafashion.com.br

# Origem pública canônica. Backend e frontend devem apontar para o mesmo domínio.
PUBLIC_APP_URL=https://app.agendafashion.com.br
VITE_PUBLIC_APP_URL=https://app.agendafashion.com.br

# Níveis aceitos: informacao, aviso, erro ou silencioso.
LOG_LEVEL=aviso

# Os testes ficam silenciosos por padrão. Ative apenas para investigar uma falha.
DEBUG_TEST_LOGS=false

# Os modelos já foram aprovados pela Meta; true ativa o envio automático.
WHATSAPP_NOTIFICATIONS_ENABLED=true

# Meta Ads fica desligado até Pixel, token e consentimento estarem prontos.
# META_CAPI_ACCESS_TOKEN é segredo de backend e nunca deve ir para VITE_* ou para o navegador.
META_ADS_ENABLED=false
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_CAPI_TEST_EVENT_CODE=
META_CAPI_TIMEOUT_MS=1800

# Google Analytics e Google Ads ficam desligados até a propriedade e as conversões serem configuradas.
# GA4_API_SECRET é segredo de backend e nunca deve ser exposto ao navegador.
GOOGLE_MEASUREMENT_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GOOGLE_ADS_ID=
GOOGLE_ADS_SIGNUP_LABEL=
GOOGLE_ADS_CHECKOUT_LABEL=
GOOGLE_MEASUREMENT_TIMEOUT_MS=1800

# Fase 11: leitura de custos de mídia.
# Essas credenciais são exclusivamente de backend. Não reutilize o token CAPI da Meta
# como token de Marketing API e nunca exponha nenhum destes valores via VITE_*.
MARKETING_COST_SYNC_TIMEOUT_MS=10000
# A Fase 13.2 exibe este estado no admin. Quando ativo, o painel também mostra
# o intervalo e considera a integração desatualizada após duas janelas sem sucesso.
# Quando desligado, a sincronização manual continua disponível e a janela é de 24h.
MARKETING_COST_SYNC_SCHEDULE_ENABLED=false
MARKETING_COST_SYNC_INTERVAL_HOURS=6

GOOGLE_ADS_COSTS_ENABLED=false
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

META_ADS_COSTS_ENABLED=false
META_AD_ACCOUNT_ID=
META_MARKETING_ACCESS_TOKEN=

# Fase 13: régua conservadora de decisão por campanha.
# A recomendação é apenas informativa: o AF não pausa nem escala campanhas automaticamente.
# 1.00 significa equilíbrio entre receita atribuída do primeiro pagamento e investimento.
MARKETING_DECISION_ROAS_TARGET=1.00
MARKETING_DECISION_SCALE_MULTIPLIER=1.20
MARKETING_DECISION_MIN_SIGNUPS=10
MARKETING_DECISION_MIN_SUBSCRIPTIONS=2
